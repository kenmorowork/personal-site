---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import companiesData from '../../../data/companies.json';

// Company page: introduction first (name, ticker, sector, business
// summary from the company's own initiation report — generated by the
// publish bridge into src/data/companies.json; HQ and homepage only
// where an in-house source holds them, otherwise omitted), then the
// full report history, newest first.
interface CompanyRec {
  slug: string;
  name: string;
  nameJa: string;
  ticker: string;
  sector: string;
  summaryEnHtml: string;
  summaryJaHtml: string;
  hq: string;
  homepage: string;
}

export async function getStaticPaths() {
  const list = ((companiesData as { companies?: CompanyRec[] }).companies ?? []) as CompanyRec[];
  const reports = await getCollection('reports', ({ data }) => data.lang === 'en');
  return list.map((company) => {
    const history = reports
      .filter((e) => e.data.company === company.name && e.data.externalUrl.startsWith('/en/reports/'))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return { params: { slug: company.slug }, props: { company, history } };
  });
}

const { company, history } = Astro.props as { company: CompanyRec; history: any[] };
const summary = company.summaryEnHtml || company.summaryJaHtml;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const badgeOf = (e: any): string => {
  if (e.id.includes('results')) return 'Results';
  return e.data.type === 'initiation' ? 'Initiation' : 'Update';
};
---

<Base
  lang="en"
  title={`${company.name} | J-Core Fundamental Research`}
  description={`${company.name} (${company.ticker}) — ${company.sector}`}
  altHref={`/ja/companies/${company.slug}/`}
>
  <p class="text-sm text-neutral-500 dark:text-neutral-400">
    <a class="underline underline-offset-2 hover:text-neutral-800 dark:hover:text-neutral-200" href="/en/reports/">Research Reports</a>
    <span class="mx-1">/</span>Companies
  </p>

  <h1 class="mt-4 font-display text-3xl font-semibold leading-snug tracking-tight">{company.name}</h1>
  {company.nameJa && <p class="mt-1 text-lg text-neutral-600 dark:text-neutral-300">{company.nameJa}</p>}

  <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
    <div class="flex gap-2">
      <dt class="text-neutral-500 dark:text-neutral-400">Ticker</dt>
      <dd class="font-medium">{company.ticker}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-neutral-500 dark:text-neutral-400">Sector</dt>
      <dd class="font-medium">{company.sector}</dd>
    </div>
    {company.hq && (
      <div class="flex gap-2">
        <dt class="text-neutral-500 dark:text-neutral-400">Head office</dt>
        <dd class="font-medium">{company.hq}</dd>
      </div>
    )}
    {company.homepage && (
      <div class="flex gap-2">
        <dt class="text-neutral-500 dark:text-neutral-400">Website</dt>
        <dd>
          <a class="font-medium underline underline-offset-2 hover:text-neutral-600 dark:hover:text-neutral-300" href={company.homepage} target="_blank" rel="noopener noreferrer">Company homepage</a>
        </dd>
      </div>
    )}
  </dl>

  {summary && (
    <div class="company-summary mt-7" set:html={summary} />
  )}

  <section class="mt-12">
    <h2 class="font-display text-xl font-semibold tracking-tight">Report history</h2>
    {history.length > 0 ? (
      <ul class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800">
        {history.map((e) => (
          <li>
            <a href={e.data.externalUrl} class="group flex items-baseline gap-3 px-1 py-3">
              <span class="shrink-0 rounded-full border border-neutral-300 px-2 py-0.5 text-[11px] font-medium text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
                {badgeOf(e)}
              </span>
              <span class="shrink-0 text-sm whitespace-nowrap text-neutral-500 tabular-nums dark:text-neutral-400">{fmt(e.data.date)}</span>
              <span class="font-medium underline-offset-4 group-hover:underline">{e.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">No reports for this company yet.</p>
    )}
  </section>
</Base>

<style>
  .company-summary :global(p) { margin: 0.9em 0; line-height: 1.85; }
  .company-summary :global(ul), .company-summary :global(ol) { margin: 0.9em 0; padding-left: 1.5em; }
  .company-summary :global(li) { margin: 0.35em 0; }
</style>
