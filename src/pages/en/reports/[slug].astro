---
import { getCollection, render } from 'astro:content';
import { companyName } from '../../../components/labels';
import Base from '../../../layouts/Base.astro';
import PriceChart from '../../../components/PriceChart.astro';
import ReportPage from '../../../components/ReportPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('reports', ({ data }) => data.lang === 'en');
  return entries
    .filter((entry) => entry.data.externalUrl.startsWith('/en/reports/'))
    .map((entry) => ({
      params: { slug: entry.id.replace(/-en$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isJa = 'en' === 'ja';

// Editor-format rendering: when the publish bridge has generated a
// render-model JSON for this report, the page IS the Editor's report
// layout; otherwise the Markdown body is rendered as before.
const base = entry.id.replace(/-en$/, '');
const models = import.meta.glob('../../../data/reports/*.json', { eager: true });
const modelMod: any = models[`../../../data/reports/${base}-en.json`];
const model = modelMod ? (modelMod.default ?? modelMod) : null;
---

<Base
  lang="en"
  title={`${entry.data.title} | J-Core Fundamental Research`}
  description={`${entry.data.company} (${entry.data.ticker}) — ${entry.data.sector}`}
  altHref="/ja/reports/"
  wide={!!model}
>
  <p class="text-sm text-neutral-500 dark:text-neutral-400">
    <a class="hover:underline" href="/en/">{isJa ? 'ホーム' : 'Home'}</a> ／ <a class="hover:underline" href="/en/reports/">{isJa ? 'アナリストレポート' : 'Analyst reports'}</a> ／ {companyName(entry.data.company, isJa ? 'ja' : 'en')}
  </p>
  {model ? (
    <div class="mt-5">
      <ReportPage model={model} lang="en" />
    </div>
  ) : (
    <>
      <h1 class="mt-4 font-display text-[clamp(28px,3.2vw,38px)] leading-snug">
        {entry.data.title}
      </h1>
      <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
        {entry.data.company} ({entry.data.ticker}) · {entry.data.sector} · {entry.data.date.toISOString().slice(0, 10)}
      </p>
      <div class="report-body mt-8">
        <Content />
      </div>
    </>
  )}
  {/* Pilot: share-price chart on the TDK (6762) report only. */}
  {entry.data.ticker === '6762' && <PriceChart lang="en" />}
  <p class="mt-12 border-t border-neutral-200 pt-6 text-sm dark:border-neutral-800">
    <a class="underline underline-offset-2 hover:text-neutral-600 dark:hover:text-neutral-300" href="/en/reports/">{isJa ? '← レポート索引に戻る' : '← Back to the reports index'}</a>
  </p>
</Base>

<style is:global>
  .report-body { line-height: 1.85; font-size: 0.95rem; overflow-wrap: break-word; }
  .report-body h2 { font-family: var(--font-sans); font-size: 1.45rem; font-weight: 600; line-height: 1.4; margin: 2.4em 0 0.8em; }
  .report-body h3 { font-size: 1.12rem; font-weight: 600; line-height: 1.5; margin: 1.9em 0 0.6em; }
  .report-body p { margin: 0.9em 0; }
  .report-body ul, .report-body ol { margin: 0.9em 0; padding-left: 1.5em; }
  .report-body ul { list-style: disc; }
  .report-body ol { list-style: decimal; }
  .report-body li { margin: 0.35em 0; }
  .report-body table { display: block; overflow-x: auto; border-collapse: collapse; margin: 1.2em 0; font-size: 0.85rem; line-height: 1.6; }
  .report-body th, .report-body td { border: 1px solid #d4d4d4; padding: 0.45em 0.7em; text-align: left; vertical-align: top; }
  .report-body th { background: #f5f5f5; font-weight: 600; }
  .dark .report-body th, .dark .report-body td { border-color: #404040; }
  .dark .report-body th { background: #171717; }
  .report-body blockquote { border-left: 3px solid #d4d4d4; padding-left: 1em; margin: 1.2em 0; color: #525252; }
  .dark .report-body blockquote { border-color: #404040; color: #a3a3a3; }
  .report-body hr { border: none; border-top: 1px solid #e5e5e5; margin: 2em 0; }
  .dark .report-body hr { border-color: #262626; }
  .report-body a { text-decoration: underline; text-underline-offset: 2px; }
</style>
