---
// Root: send visitors to their language tree, with manual links as fallback.
import '../styles/global.css';
import { NAME, TAGLINE } from '../data/site';

// The root URL is the one people share most, so it carries the same
// sharing and indexing metadata as the pages inside the language trees.
const SITE_NAME = 'J-Core Fundamental Research';
const DESCRIPTION =
  'Ken — JP Equity Analyst (Industrials, Materials, others) | Tokyo |';
const origin = Astro.site ?? new URL('https://kenmorozumi.com');
const url = (p: string) => new URL(p, origin).href;
const ogImage = url('/og/j-core-og.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{NAME} — {TAGLINE}</title>
    <meta name="description" content={DESCRIPTION} />

    <link rel="canonical" href={url('/')} />
    <link rel="alternate" hreflang="ja" href={url('/ja/')} />
    <link rel="alternate" hreflang="en" href={url('/en/')} />
    <link rel="alternate" hreflang="x-default" href={url('/')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={NAME} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={url('/')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@moro_ken_jp" />
    <meta name="twitter:title" content={NAME} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        var ja =
          (navigator.language || '').toLowerCase().indexOf('ja') === 0;
        window.location.replace(ja ? '/ja/' : '/en/');
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen items-center justify-center bg-white px-6 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100"
  >
    <main class="text-center">
      <h1 class="font-display text-[clamp(28px,3.2vw,38px)] leading-tight">{NAME}</h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">{TAGLINE}</p>
      <p class="mt-8 flex items-center justify-center gap-4">
        <a
          href="/ja/"
          class="rounded-full border border-neutral-300 px-5 py-2 hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-900"
          >日本語</a
        >
        <a
          href="/en/"
          class="rounded-full border border-neutral-300 px-5 py-2 hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-900"
          >English</a
        >
      </p>
    </main>
  </body>
</html>
