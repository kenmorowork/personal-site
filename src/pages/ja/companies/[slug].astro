---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CompanyPage from '../../../components/CompanyPage.astro';
import companiesData from '../../../data/companies.json';
import companyMeta from '../../../data/company-meta.json';
import pricesData from '../../../data/prices.json';
import sharesData from '../../../data/shares.json';
import assetsData from '../../../data/company-assets.json';

// Company page (approved Fanuc MVP shape, rolled out to all covered
// companies): identity block + market band + price chart, then the
// report history. Numbers wire to the daily-refreshed data files:
// prices.json (current price), src/data/prices/<ticker>.json (daily
// closes for the chart and performance), shares.json (shares
// outstanding from the J-Core Valuation DB, for market cap).
interface CompanyRec {
  slug: string;
  name: string;
  nameJa: string;
  ticker: string;
  sector: string;
  summaryEnHtml: string;
  summaryJaHtml: string;
  hq: string;
  homepage: string;
}

export async function getStaticPaths() {
  const historyFiles = import.meta.glob('../../../data/prices/*.json', {
    eager: true,
  }) as Record<string, any>;
  const list = ((companiesData as { companies?: CompanyRec[] }).companies ??
    []) as CompanyRec[];
  const meta = companyMeta as Record<
    string,
    { nameJa: string; marketJa: string; marketEn: string }
  >;
  const prices = (pricesData as { prices: Record<string, any> }).prices;
  const shares = (sharesData as { shares: Record<string, any> }).shares;
  const assets = assetsData as Record<string, any>;
  const reports = await getCollection(
    'reports',
    ({ data }) => data.lang === 'ja',
  );
  return list.map((company) => {
    const history = reports
      .filter(
        (e) =>
          e.data.company === company.name &&
          e.data.externalUrl.startsWith('/ja/reports/'),
      )
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    // Rating / target: the latest report that actually states them.
    let rating: string | null = null;
    let target: number | null = null;
    let ratingReportDate: Date | null = null;
    for (const e of history) {
      if (e.data.rating && e.data.targetPrice) {
        const n = parseFloat(
          e.data.targetPrice.replace(/[^0-9.]/g, ''),
        );
        if (Number.isFinite(n) && n > 0) {
          rating = e.data.rating;
          target = n;
          ratingReportDate = e.data.date;
        }
        break;
      }
    }

    const price = prices[company.ticker] ?? null;
    const sh = shares[company.ticker]?.sharesMn;
    const marketCap =
      price && typeof sh === 'number' ? price.price * sh * 1e6 : null;

    const hist =
      historyFiles[`../../../data/prices/${company.ticker}.json`]
        ?.default ?? null;
    const a = assets[company.slug] ?? {};

    return {
      params: { slug: company.slug },
      props: {
        company,
        nameJa: meta[company.slug]?.nameJa ?? company.name,
        market: meta[company.slug]?.marketJa ?? '',
        price,
        marketCap,
        rating,
        target,
        ratingReportDate,
        closes: hist?.closes ?? [],
        chartFrom: hist?.from ?? '',
        chartTo: hist?.to ?? '',
        chartSymbol: hist?.symbol ?? company.ticker,
        logoFile: a.logo ?? null,
        photoFile: a.photo ?? null,
        photoCredit: a.photoCredit ?? null,
        history,
      },
    };
  });
}

const props = Astro.props as any;
---

<Base
  lang="ja"
  title={`${props.nameJa}（${props.company.ticker}） | J-Core Research by Ken`}
  description={`${props.nameJa}（${props.company.ticker}）— ${props.company.sector}`}
  altHref={`/en/companies/${props.company.slug}/`}
>
  <CompanyPage lang="ja" {...props} />
</Base>
