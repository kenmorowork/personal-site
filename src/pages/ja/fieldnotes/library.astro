---
// @ts-ignore - raw HTML import of the FIELDNOTES library (topic app)
import hubHtml from '../../../fieldnotes/hub-ja.html?raw';

// The FIELDNOTES library app, served as-is (its own layout, full width).
// It carries <base href="/fieldnotes-space/"> so its views keep loading
// from /fieldnotes-space/. Its topic links pointed at /ja/fieldnotes/#/…;
// they now point here, where the app lives since the index was rebuilt.
const html = (hubHtml as string).split('/ja/fieldnotes/#/').join('/ja/fieldnotes/library/#/');

// The app brings its own <head>, so this page never passes through
// Base.astro. The same sharing and indexing metadata is injected here.
// Every URL is absolute: the page's <base href="/fieldnotes-space/">
// would resolve a relative one against that directory instead.
const origin = Astro.site ?? new URL('https://kenmorozumi.com');
const url = (p: string) => new URL(p, origin).href;
const SITE_NAME = 'J-Core Fundamental Research';
const TITLE = 'FIELDNOTES — 業界レポートのライブラリ';
const DESCRIPTION =
  '日本の産業・素材・エネルギーを対象にした業界レポートを、テーマ別にまとめたライブラリです。';
const meta = `
    <meta name="description" content="${DESCRIPTION}" />
    <link rel="canonical" href="${url('/ja/fieldnotes/library/')}" />
    <link rel="alternate" hreflang="ja" href="${url('/ja/fieldnotes/library/')}" />
    <link rel="alternate" hreflang="en" href="${url('/en/fieldnotes/library/')}" />
    <link rel="alternate" hreflang="x-default" href="${url('/')}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="${SITE_NAME}" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content="${TITLE}" />
    <meta property="og:description" content="${DESCRIPTION}" />
    <meta property="og:url" content="${url('/ja/fieldnotes/library/')}" />
    <meta property="og:image" content="${url('/og/j-core-og.png')}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="${SITE_NAME}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@moro_ken_jp" />
    <meta name="twitter:title" content="${TITLE}" />
    <meta name="twitter:description" content="${DESCRIPTION}" />
    <meta name="twitter:image" content="${url('/og/j-core-og.png')}" />
  `;
const page = html.replace('</head>', `${meta}</head>`);
---

<Fragment set:html={page} />
