---
import { getCollection } from 'astro:content';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const isJa = lang === 'ja';

const items = (await getCollection('portfolio', ({ data }) => data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  isJa
    ? `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`
    : d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });

const isExternal = (url: string) => url.startsWith('http');
---

<h1 class="font-display text-[clamp(28px,3.2vw,38px)] leading-tight">
  {isJa ? 'ポートフォリオ' : 'Portfolio'}
</h1>

<p class="mt-6 max-w-prose leading-relaxed">
  {
    isJa
      ? '日々の配信以外の成果物です。長編の検証、データベース、ダッシュボードなど、時間をかけて作ったものを置いています。'
      : 'Work beyond the daily publishing rhythm: long-form studies, databases and dashboards — pieces built to be used for a long time.'
  }
</p>

<div class="mt-10 grid gap-4 sm:grid-cols-2">
  {
    items.map((item) => (
      <a
        href={item.data.externalUrl}
        {...(isExternal(item.data.externalUrl)
          ? { target: '_blank', rel: 'noopener noreferrer' }
          : {})}
        class="group border border-neutral-200 p-5 transition hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
      >
        <div class="flex items-baseline justify-between gap-2">
          <span class="bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
            {item.data.kind}
          </span>
          <time
            datetime={item.data.date.toISOString()}
            class="text-sm text-neutral-500 dark:text-neutral-400"
          >
            {fmt(item.data.date)}
          </time>
        </div>
        <p class="mt-3 font-display text-lg font-semibold leading-snug">{item.data.title}</p>
        <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
          {item.data.summary}
        </p>
        <p class="mt-3 text-sm font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
          {isJa ? '開く →' : 'Open →'}
        </p>
      </a>
    ))
  }
</div>
