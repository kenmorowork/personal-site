---
import { getCollection } from 'astro:content';
import type { Lang } from '../data/site';
import companiesData from '../data/companies.json';
import {
  companyName,
  companySlug,
  fmtDate,
  fmtLong,
  fmtShort,
  newsHref,
  newsSector,
  reportKind,
  reportSector,
  reportTypeLabel,
} from './labels';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const isJa = lang === 'ja';
const base = isJa ? '/ja' : '/en';
const SUBSTACK_URL = 'https://morokenjp.substack.com/';

const byDate = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

/* ---------- Market update: the newest news items ---------- */
const news = (await getCollection('news', ({ data }) => data.lang === lang)).sort(byDate);
const lead = news[0];
const grid = news.slice(1, 5);
const heads = news.slice(5, 13);

/* ---------- Analyst reports ---------- */
const reports = (await getCollection('reports', ({ data }) => data.lang === lang))
  .filter((e) => !e.id.includes('daifuku-initiation-59'))
  .sort(byDate);
const latestWeekly = reports.find((r) => reportKind(r.data.company) === 'weekly');
const latestSector = reports.find((r) => reportKind(r.data.company) === 'sector');
const companyRows = reports.filter((r) => reportKind(r.data.company) === 'company').slice(0, 6);
const companySlugs = new Set(
  ((companiesData as { companies?: { slug: string }[] }).companies ?? []).map((c) => c.slug),
);
const companyHref = (name: string) => {
  const slug = companySlug(name);
  return companySlugs.has(slug) ? `${base}/companies/${slug}/` : null;
};
const periodic = [
  latestWeekly && {
    kind: isJa ? '週次マーケットレポート' : 'Weekly market report',
    next: isJa ? '毎週' : 'Weekly',
    entry: latestWeekly,
  },
  latestSector && {
    kind: isJa ? 'セクター・アップデート' : 'Sector update',
    next: isJa ? '毎月' : 'Monthly',
    entry: latestSector,
  },
].filter(Boolean) as { kind: string; next: string; entry: (typeof reports)[number] }[];

/* ---------- Industry reports (Field Notes) ---------- */
const fieldnotes = (await getCollection('fieldnotes', ({ data }) => data.lang === 'ja')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.no - a.data.no,
);
const fnNew = fieldnotes.slice(0, 6);
const groupLabel = (g: string) =>
  isJa
    ? ({ industrials: '産業', materials: '素材', energy: 'エネルギー' } as Record<string, string>)[g] ?? g
    : ({ industrials: 'Industrials', materials: 'Materials', energy: 'Energy' } as Record<string, string>)[g] ?? g;

const stats = [
  { label: isJa ? 'マーケット短報' : 'Market briefs', value: isJa ? '1日3回' : '3× daily', note: '' },
  { label: isJa ? 'アナリストレポート' : 'Analyst reports', value: isJa ? '毎週' : 'Weekly', note: isJa ? '＋随時' : ' + ad hoc' },
  { label: isJa ? '業界レポート' : 'Industry reports', value: String(fieldnotes.length), note: isJa ? ' 本' : '' },
];
---

<!-- Masthead -->
<section class="jc-wrap flex flex-wrap items-end justify-between gap-x-10 gap-y-6 pt-8 pb-7">
  <div class="min-w-0">
    <p class="text-xs font-semibold tracking-[0.08em] text-navy dark:text-sky">
      {isJa ? '東京拠点・日本株' : 'Tokyo · Japanese equities'}
    </p>
    <h1 class="font-display mt-2 text-[clamp(30px,3.6vw,44px)] leading-tight tracking-[0.02em]">J-Core Research</h1>
  </div>
  <dl class="grid grid-cols-3 gap-[clamp(12px,3vw,24px)]">
    {
      stats.map((s) => (
        <div class="min-w-[clamp(92px,26vw,140px)] border-t-2 border-neutral-900 pt-2.5 dark:border-neutral-300">
          <dt class="text-[clamp(10.5px,2.8vw,12px)] text-neutral-500 dark:text-neutral-400">{s.label}</dt>
          <dd class="num mt-1.5 text-[clamp(16px,4.6vw,21px)] font-semibold">
            {s.value}
            {s.note && <span class="text-[13px] font-medium text-neutral-500 dark:text-neutral-400">{s.note}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- Market update -->
{
  lead && (
    <section id="market" class="jc-wrap pt-2 pb-14">
      <div class="jc-head">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 class="font-display text-[26px]">{isJa ? 'マーケット・アップデート' : 'Market update'}</h2>
          <span class="text-[13px] text-neutral-500 dark:text-neutral-400">{fmtLong(lead.data.date, lang)}</span>
        </div>
        <a href={`${base}/news/`} class="text-[13px] font-semibold text-navy hover:underline dark:text-sky">
          {isJa ? 'ニュース一覧 →' : 'All news →'}
        </a>
      </div>

      <article class="max-w-3xl">
        <div class="mb-3 flex items-center gap-3 text-xs">
          <span class="bg-navy px-2 py-0.5 font-semibold tracking-[0.04em] text-white dark:bg-sky dark:text-neutral-950">
            {newsSector(lead.data.sector, lang)}
          </span>
          <time class="num text-neutral-500 dark:text-neutral-400" datetime={lead.data.date.toISOString()}>
            {fmtDate(lead.data.date, lang)}
          </time>
        </div>
        <h3 class="text-[clamp(22px,2.2vw,27px)] leading-[1.45] font-semibold">
          <a href={newsHref(lead.id, lang)} class="hover:underline">
            {lead.data.title}
          </a>
        </h3>
        <p class="mt-4 text-base leading-[1.85] text-neutral-600 dark:text-neutral-300">{lead.data.summary}</p>
        <a
          href={newsHref(lead.id, lang)}
          class="mt-4 inline-block text-[13px] font-semibold text-navy hover:underline dark:text-sky"
        >
          {isJa ? '記事を読む →' : 'Read the item →'}
        </a>
      </article>

      {
        grid.length > 0 && (
          <>
            <h3 class="mt-12 text-base font-semibold">{isJa ? 'そのほかの注目ニュース' : 'More news'}</h3>
            <div class="mt-3.5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {grid.map((n) => (
                <article class="border-t-2 border-neutral-900 pt-3.5 dark:border-neutral-300">
                  <div class="mb-2.5 flex items-center gap-2.5 text-xs">
                    <span class="bg-neutral-100 px-2 py-0.5 font-semibold text-navy dark:bg-neutral-900 dark:text-sky">
                      {newsSector(n.data.sector, lang)}
                    </span>
                    <time class="num text-neutral-500 dark:text-neutral-400" datetime={n.data.date.toISOString()}>
                      {fmtShort(n.data.date, lang)}
                    </time>
                  </div>
                  <h4 class="text-[16.5px] leading-[1.55] font-semibold">
                    <a href={newsHref(n.id, lang)} class="hover:underline">
                      {n.data.title}
                    </a>
                  </h4>
                  <p class="mt-2.5 line-clamp-4 text-sm leading-[1.75] text-neutral-600 dark:text-neutral-300">{n.data.summary}</p>
                </article>
              ))}
            </div>
          </>
        )
      }

      {
        heads.length > 0 && (
          <>
            <h3 class="mt-12 text-base font-semibold">{isJa ? 'ヘッドライン' : 'Headlines'}</h3>
            <ul class="mt-1">
              {heads.map((h) => (
                <li>
                  <a
                    href={newsHref(h.id, lang)}
                    class="grid grid-cols-[44px_minmax(0,1fr)] items-baseline gap-x-3 gap-y-0.5 border-b border-neutral-200 py-3 hover:bg-neutral-50 sm:grid-cols-[52px_128px_minmax(0,1fr)] dark:border-neutral-800 dark:hover:bg-neutral-900"
                  >
                    <span class="num text-[13px] text-neutral-500 dark:text-neutral-400">{fmtShort(h.data.date, lang)}</span>
                    <span class="hidden text-xs font-semibold text-navy sm:block dark:text-sky">{newsSector(h.data.sector, lang)}</span>
                    <span class="text-[15px] leading-relaxed">{h.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>
  )
}

<!-- Analyst reports -->
<section id="reports" class="border-y border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900">
  <div class="jc-wrap py-13">
    <div class="jc-head">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h2 class="font-display text-[26px]">{isJa ? 'アナリストレポート' : 'Analyst reports'}</h2>
        <span class="text-[13px] text-neutral-500 dark:text-neutral-400">
          {isJa ? '週次・月次の定期レポートと、個別銘柄のレポート' : 'Weekly and monthly reports, and company reports'}
        </span>
      </div>
      <a href={`${base}/reports/`} class="text-[13px] font-semibold text-navy hover:underline dark:text-sky">
        {isJa ? 'すべてのレポート →' : 'All reports →'}
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        periodic.map((p) => (
          <a
            href={p.entry.data.externalUrl}
            class="flex flex-col gap-2.5 border border-l-4 border-neutral-200 border-l-navy bg-white px-6 py-5 hover:border-neutral-300 dark:border-neutral-800 dark:border-l-sky dark:bg-neutral-950"
          >
            <span class="flex flex-wrap justify-between gap-3 text-xs text-neutral-500 dark:text-neutral-400">
              <span>
                <span class="font-semibold text-neutral-900 dark:text-neutral-100">{p.kind}</span>
                {isJa ? ' · 最新号 ' : ' · latest '}
                <span class="num">{fmtDate(p.entry.data.date, lang)}</span>
              </span>
              <span>{p.next}</span>
            </span>
            <span class="text-xl leading-[1.55] font-semibold">{p.entry.data.title}</span>
            <span class="mt-auto text-[13px] font-semibold text-navy dark:text-sky">{isJa ? 'レポートを読む →' : 'Read the report →'}</span>
          </a>
        ))
      }
    </div>

    {
      companyRows.length > 0 && (
        <>
          <h3 class="mt-10 text-base font-semibold">{isJa ? '個別銘柄の最近のレポート' : 'Recent company reports'}</h3>
          <div class="mt-3.5 overflow-x-auto border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950">
            <table class="w-full min-w-[680px] border-collapse text-left">
              <thead>
                <tr class="bg-neutral-50 text-xs text-neutral-500 dark:bg-neutral-900 dark:text-neutral-400">
                  <th class="border-b border-neutral-200 px-5 py-3 font-medium whitespace-nowrap dark:border-neutral-800">{isJa ? '更新日' : 'Date'}</th>
                  <th class="border-b border-neutral-200 px-5 py-3 font-medium dark:border-neutral-800">{isJa ? '銘柄' : 'Company'}</th>
                  <th class="border-b border-neutral-200 px-5 py-3 font-medium dark:border-neutral-800">{isJa ? '論点' : 'Headline'}</th>
                  <th class="border-b border-neutral-200 px-5 py-3 font-medium dark:border-neutral-800">{isJa ? 'セクター' : 'Sector'}</th>
                </tr>
              </thead>
              <tbody>
                {companyRows.map((r) => {
                  const href = companyHref(r.data.company);
                  const ticker = r.data.ticker && r.data.ticker !== '—' ? r.data.ticker : '';
                  return (
                    <tr class="align-middle">
                      <td class="border-b border-neutral-100 px-5 py-4 whitespace-nowrap dark:border-neutral-900">
                        <span class="num block text-sm font-medium">{fmtShort(r.data.date, lang)}</span>
                        <span class="mt-1 block text-xs text-neutral-500 dark:text-neutral-400">{reportTypeLabel(r.id, r.data.type, lang)}</span>
                      </td>
                      <td class="border-b border-neutral-100 px-5 py-4 dark:border-neutral-900">
                        {href ? (
                          <a href={href} class="block text-[15px] font-semibold hover:underline">{companyName(r.data.company, lang)}</a>
                        ) : (
                          <span class="block text-[15px] font-semibold">{companyName(r.data.company, lang)}</span>
                        )}
                        {ticker && <span class="num mt-0.5 block text-xs text-neutral-500 dark:text-neutral-400">{ticker}</span>}
                      </td>
                      <td class="border-b border-neutral-100 px-5 py-4 text-sm leading-relaxed text-neutral-600 dark:border-neutral-900 dark:text-neutral-300">
                        <a href={r.data.externalUrl} class="hover:underline">{r.data.title}</a>
                      </td>
                      <td class="border-b border-neutral-100 px-5 py-4 text-[13.5px] whitespace-nowrap text-neutral-600 dark:border-neutral-900 dark:text-neutral-300">
                        {reportSector(r.data.sector, lang)}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )
    }
  </div>
</section>

<!-- Industry reports -->
<section id="fieldnotes" class="jc-wrap pt-14 pb-16">
  <div class="jc-head">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h2 class="font-display text-[26px]">{isJa ? '業界レポート' : 'Industry reports'}</h2>
      <span class="text-sm text-neutral-500 dark:text-neutral-400">
        {isJa ? '業界統計とバリューチェーンのデータベース' : 'Industry statistics and value chains'}
      </span>
    </div>
    <a href={`${base}/fieldnotes/`} class="text-[13px] font-semibold text-navy hover:underline dark:text-sky">
      {isJa ? 'すべて開く →' : 'Open all →'}
    </a>
  </div>
  <h3 class="text-base font-semibold">{isJa ? '新着' : 'New'}</h3>
  <div class="mt-3.5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      fnNew.map((f) => (
        <a
          href={`/ja/fieldnotes/${f.id.replace(/-ja$/, '')}/`}
          class="flex flex-col gap-2 border border-neutral-200 bg-white p-5 hover:border-neutral-400 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:border-neutral-600"
        >
          <span class="flex flex-wrap gap-x-2 text-xs text-neutral-500 dark:text-neutral-400">
            <span class="font-semibold text-navy dark:text-sky">{groupLabel(f.data.group)}</span>
            <span class="num">No.{f.data.no}</span>
            <span class="num">{fmtDate(f.data.date, lang)}</span>
          </span>
          <span class="text-[16.5px] leading-snug font-semibold">{isJa ? f.data.title : (f.data.titleEn ?? f.data.title)}</span>
        </a>
      ))
    }
  </div>
</section>

<!-- Subscribe -->
<section aria-label={isJa ? '購読' : 'Subscribe'} class="bg-navy text-white">
  <div class="jc-wrap flex flex-wrap items-center justify-between gap-6 py-10">
    <div>
      <p class="text-lg font-semibold">{isJa ? '更新をメールで受け取る' : 'Get updates by email'}</p>
      <p class="mt-1.5 text-sm text-neutral-200">
        {isJa ? 'アナリストレポートと業界レポートの新着を、Substackでお届けします。無料です。' : 'New analyst and industry reports, delivered free via Substack.'}
      </p>
    </div>
    <a href={SUBSTACK_URL} class="bg-white px-5 py-3 text-sm font-semibold text-navy hover:bg-neutral-100">
      {isJa ? '無料で購読する' : 'Subscribe free'}
    </a>
  </div>
</section>
