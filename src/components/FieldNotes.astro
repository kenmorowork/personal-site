---
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const isJa = lang === 'ja';
const base = isJa ? '/ja' : '/en';

const sectors = isJa
  ? [
      {
        area: 'インダストリアル',
        count: '産業レポート 43本',
        detail:
          '変圧器・電力機器、工作機械、建設機械、AIデータセンター設備、防衛など。受注・出荷の一次統計とバリューチェーンで業界を読む中核領域です。',
      },
      {
        area: '素材',
        count: '産業レポート 22本',
        detail:
          '電池材料、炭素繊維、電線・ケーブル、半導体材料など。価格と需給のサイクルを、資源から最終用途までつないで追います。',
      },
      {
        area: 'エネルギー',
        count: '産業レポート 12本',
        detail:
          '電力インフラ、送配電、海底ケーブル、洋上風力など。AIデータセンターの電力需要を起点に、系統側の制約を整理します。',
      },
    ]
  : [
      {
        area: 'Industrials',
        count: '43 sector reports',
        detail:
          'Transformers and power equipment, machine tools, construction machinery, AI data-centre equipment and defence — the core library, reading industries through primary order/shipment statistics and value chains.',
      },
      {
        area: 'Materials',
        count: '22 sector reports',
        detail:
          'Battery materials, carbon fibre, wire and cable, semiconductor materials — price and supply/demand cycles traced from resources to end use.',
      },
      {
        area: 'Energy',
        count: '12 sector reports',
        detail:
          'Power infrastructure, transmission and distribution, submarine cables and offshore wind — the grid-side constraints behind AI data-centre power demand.',
      },
    ];
---

<h1 class="font-display text-3xl font-semibold tracking-tight">FIELDNOTES</h1>

<p class="mt-6 max-w-prose leading-relaxed">
  {
    isJa
      ? 'FIELDNOTESは、業界統計・企業開示・取材メモを蓄積する調査基盤です。セクターごとの統計ページとバリューチェーン分析を土台に、日々のニュース配信とJ-Coreのリサーチレポートが生まれます。現在、産業レポート77本を含む242ページを収録しています。'
      : 'FIELDNOTES is the research library behind everything published here: industry statistics, company disclosures and interview notes, organised by sector with value-chain analysis. It currently holds 242 pages, including 77 sector reports — the base from which the daily news and the J-Core research reports are written.'
  }
</p>

<section class="mt-10">
  <h2 class="font-display text-xl font-semibold">{isJa ? 'セクター構成' : 'Sector overview'}</h2>
  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    {
      sectors.map((s) => (
        <div class="rounded-lg border border-neutral-200 p-5 dark:border-neutral-800">
          <p class="font-display text-lg font-semibold">{s.area}</p>
          <p class="mt-1 text-sm font-medium text-neutral-500 dark:text-neutral-400">{s.count}</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            {s.detail}
          </p>
        </div>
      ))
    }
  </div>
</section>

<section class="mt-12 rounded-lg border border-neutral-200 p-6 dark:border-neutral-800">
  <h2 class="font-display text-xl font-semibold">
    {isJa ? '全文へのアクセス' : 'Access to the full library'}
  </h2>
  <p class="mt-3 max-w-prose leading-relaxed text-neutral-600 dark:text-neutral-400">
    {
      isJa
        ? 'FIELDNOTESの全文は専用のSpaceで公開しています。このサイトでは公開窓口として、レポートの索引と各セクターの概要を載せています。全文の閲覧や取材のご連絡は、Aboutページの連絡先からお願いします。'
        : 'The full FIELDNOTES library lives in its own Space. This site carries the public window — the report index and the sector overviews. For full-text access or interview requests, please use the contact routes on the About page.'
    }
  </p>
  <p class="mt-5 flex flex-wrap gap-3">
    <a
      href={`${base}/reports/`}
      class="rounded-full bg-neutral-900 px-5 py-2 text-sm font-medium text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
    >
      {isJa ? 'レポート索引を見る' : 'Browse the report index'}
    </a>
    <a
      href={`${base}/about/`}
      class="rounded-full border border-neutral-300 px-5 py-2 text-sm font-medium hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-900"
    >
      {isJa ? 'About・連絡先' : 'About & contact'}
    </a>
  </p>
</section>
