---
import { getCollection } from 'astro:content';
import type { Lang } from '../data/site';
import { fmtLong, newsHref, newsSector } from './labels';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const isJa = lang === 'ja';
const base = isJa ? '/ja' : '/en';

const items = (await getCollection('news', ({ data }) => data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Day groups (newest first) and month groups for the calendars.
const key = (d: Date) => d.toISOString().slice(0, 10);
const days = new Map<string, typeof items>();
for (const it of items) {
  const k = key(it.data.date);
  days.set(k, [...(days.get(k) ?? []), it]);
}
const months = new Map<string, string[]>();
for (const k of days.keys()) {
  const m = k.slice(0, 7);
  months.set(m, [...(months.get(m) ?? []), k]);
}
const maxPerDay = Math.max(1, ...[...days.values()].map((v) => v.length));
const shade = (n: number) => {
  const t = n / maxPerDay;
  return t > 0.66 ? 'bg-navy text-white dark:bg-sky dark:text-neutral-950' : t > 0.33 ? 'bg-neutral-300 dark:bg-neutral-700' : 'bg-neutral-100 dark:bg-neutral-800';
};
const monthLabel = (m: string) => {
  const [y, mo] = m.split('-').map(Number);
  return isJa ? `${y}年${mo}月` : new Date(Date.UTC(y, mo - 1, 1)).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
};
const calendar = (m: string) => {
  const [y, mo] = m.split('-').map(Number);
  const first = new Date(Date.UTC(y, mo - 1, 1)).getUTCDay();
  const last = new Date(Date.UTC(y, mo, 0)).getUTCDate();
  const cells: ({ day: number; k: string; n: number } | null)[] = Array(first).fill(null);
  for (let d = 1; d <= last; d++) {
    const k = `${m}-${String(d).padStart(2, '0')}`;
    cells.push({ day: d, k, n: days.get(k)?.length ?? 0 });
  }
  return cells;
};
const week = isJa ? ['日', '月', '火', '水', '木', '金', '土'] : ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
---

<p class="text-[13px] text-neutral-500 dark:text-neutral-400">
  <a href={`${base}/`} class="hover:underline">{isJa ? 'ホーム' : 'Home'}</a> ／
  <a href={`${base}/news/`} class="hover:underline">{isJa ? 'マーケット・ニュース' : 'Market news'}</a> ／
  {isJa ? 'アーカイブ' : 'Archive'}
</p>
<h1 class="font-display mt-4 text-[clamp(28px,3.2vw,38px)] leading-tight">{isJa ? 'ニュース・アーカイブ' : 'News archive'}</h1>
<p class="mt-3 max-w-2xl leading-relaxed text-neutral-600 dark:text-neutral-300">
  {isJa ? `これまでのマーケット・ニュース${items.length}本を、日付ごとに並べています。カレンダーの日付を押すと、その日の見出しに移ります。` : `All ${items.length} market news items, by day. Pick a date in the calendar to jump to that day.`}
</p>

<div class="mt-8 grid gap-10 lg:grid-cols-[300px_minmax(0,1fr)]">
  <div class="flex flex-col gap-8 lg:sticky lg:top-28 lg:self-start">
    {
      [...months.keys()].map((m) => (
        <section aria-label={monthLabel(m)}>
          <h2 class="flex items-baseline justify-between border-b-2 border-neutral-900 pb-2 text-base font-semibold dark:border-neutral-300">
            {monthLabel(m)}
            <span class="num text-xs font-normal text-neutral-500 dark:text-neutral-400">
              {(months.get(m) ?? []).reduce((n, k) => n + (days.get(k)?.length ?? 0), 0)}{isJa ? '本' : ' items'}
            </span>
          </h2>
          <div class="num mt-3 grid grid-cols-7 gap-1 text-center text-xs">
            {week.map((w) => <span class="py-1 text-neutral-500 dark:text-neutral-400">{w}</span>)}
            {calendar(m).map((c) =>
              c === null ? (
                <span />
              ) : c.n > 0 ? (
                <a href={`#d-${c.k}`} class={`flex h-9 flex-col items-center justify-center leading-tight ${shade(c.n)}`} aria-label={isJa ? `${c.day}日、${c.n}本` : `${c.day}: ${c.n} items`}>
                  <span>{c.day}</span>
                  <span class="text-[10px] opacity-80">{c.n}</span>
                </a>
              ) : (
                <span class="flex h-9 items-center justify-center text-neutral-300 dark:text-neutral-700">{c.day}</span>
              ),
            )}
          </div>
          <p class="mt-2 flex items-center gap-2 text-[11px] text-neutral-500 dark:text-neutral-400">
            {isJa ? '少ない' : 'Fewer'}
            <span class="inline-block h-3 w-4 bg-neutral-100 dark:bg-neutral-800" />
            <span class="inline-block h-3 w-4 bg-neutral-300 dark:bg-neutral-700" />
            <span class="inline-block h-3 w-4 bg-navy dark:bg-sky" />
            {isJa ? '多い' : 'More'}
          </p>
        </section>
      ))
    }
  </div>

  <div>
    {
      [...days.entries()].map(([k, rows]) => (
        <section id={`d-${k}`} class="mb-10 scroll-mt-28">
          <h2 class="flex items-baseline justify-between border-b-2 border-neutral-900 pb-2 text-base font-semibold dark:border-neutral-300">
            {fmtLong(rows[0].data.date, lang)}
            <span class="num text-xs font-normal text-neutral-500 dark:text-neutral-400">{rows.length}{isJa ? '本' : ''}</span>
          </h2>
          <ul>
            {rows.map((n) => (
              <li>
                <a href={newsHref(n.id, lang)} class="grid grid-cols-[minmax(0,1fr)] gap-1 border-b border-neutral-200 py-3 hover:bg-neutral-50 sm:grid-cols-[128px_minmax(0,1fr)] sm:gap-3 dark:border-neutral-800 dark:hover:bg-neutral-900">
                  <span class="text-xs font-semibold text-navy dark:text-sky">{newsSector(n.data.sector, lang)}</span>
                  <span class="text-[15px] leading-relaxed">{n.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>
