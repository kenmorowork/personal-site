---
import { getCollection } from 'astro:content';
import type { Lang } from '../data/site';
// @ts-ignore - raw HTML of the FIELDNOTES library index, parsed at build time for the topic list.
import hubJaHtml from '../fieldnotes/hub-ja.html?raw';
// @ts-ignore - see above.
import hubEnHtml from '../fieldnotes/hub-en.html?raw';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const isJa = lang === 'ja';
const base = isJa ? '/ja' : '/en';
const library = `${base}/fieldnotes/library/`;
const SUBSTACK_URL = 'https://morokenjp.substack.com/';

/* ---------- Industry reports (the Field Notes collection) ---------- */
const reports = (await getCollection('fieldnotes', ({ data }) => data.lang === 'ja')).sort((a, b) => a.data.no - b.data.no);
const groups = [
  { key: 'industrials', name: isJa ? '産業' : 'Industrials', desc: isJa ? '機械・電機・データセンター設備・防衛など' : 'Machinery, electrical equipment, data-centre equipment, defence' },
  { key: 'materials', name: isJa ? '素材' : 'Materials', desc: isJa ? '電池材料・炭素繊維・電線・半導体材料など' : 'Battery materials, carbon fibre, wire and cable, semiconductor materials' },
  { key: 'energy', name: isJa ? 'エネルギー' : 'Energy', desc: isJa ? '発電・送配電・蓄電・洋上風力など' : 'Generation, transmission, storage, offshore wind' },
].map((g) => ({ ...g, rows: reports.filter((r) => r.data.group === g.key) }));
const slugOf = (id: string) => id.replace(/-ja$/, '');

/* ---------- Topic index (parsed from the library's own index) ---------- */
interface FnState { label: string; goto: string | null }
interface FnRow { kind: 'topic' | 'sub'; name: string; states: FnState[] }
const stripTags = (s: string) =>
  s.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();
function parseHub(html: string) {
  const headRe = /<span class="sec-no">(§\d+)<\/span>([^<]+?)(?:<span class="sec-count">（(\d+)件）<\/span>)?/g;
  const heads: { no: string; name: string; idx: number }[] = [];
  let m: RegExpExecArray | null;
  while ((m = headRe.exec(html))) heads.push({ no: m[1], name: stripTags(m[2]), idx: m.index });
  const out: { no: string; name: string; rows: FnRow[] }[] = [];
  for (let i = 0; i < heads.length; i++) {
    const chunk = html.slice(heads[i].idx, i + 1 < heads.length ? heads[i + 1].idx : html.length);
    const table = chunk.match(/<table class="topic-table">([\s\S]*?)<\/table>/);
    if (!table) continue;
    const rows: FnRow[] = [];
    const rowRe = /<tr([^>]*)>([\s\S]*?)<\/tr>/g;
    let r: RegExpExecArray | null;
    while ((r = rowRe.exec(table[1]))) {
      if (r[1].includes('subrow')) {
        rows.push({ kind: 'sub', name: stripTags(r[2]), states: [] });
        continue;
      }
      const nameM = r[2].match(/<td class="t-name">([\s\S]*?)<\/td>/);
      if (!nameM) continue;
      const states = [...r[2].matchAll(/<td class="t-state">([\s\S]*?)<\/td>/g)].map((c) => {
        const g = c[1].match(/data-goto="([^"]+)"/);
        return { label: stripTags(c[1]), goto: g ? g[1] : null };
      });
      rows.push({ kind: 'topic', name: stripTags(nameM[1]), states });
    }
    out.push({ no: heads[i].no, name: heads[i].name, rows });
  }
  return out;
}
const EXCLUDE = new Set(['§1', '§15', '§16']);
const sectors = parseHub(isJa ? hubJaHtml : hubEnHtml).filter((s) => !EXCLUDE.has(s.no));
const topicCount = sectors.reduce((n, s) => n + s.rows.filter((r) => r.kind === 'topic').length, 0);
const kinds = isJa ? ['統計', 'VC'] : ['Stats', 'VC'];
---

<script is:inline define:vars={{ library }}>
  // Old library links (#/topic) open the FIELDNOTES library, which now lives one level down.
  if (location.hash.indexOf('#/') === 0) location.replace(library + location.hash);
</script>

<p class="text-[13px] text-neutral-500 dark:text-neutral-400">
  <a href={`${base}/`} class="hover:underline">{isJa ? 'ホーム' : 'Home'}</a> ／ {isJa ? '業界レポート' : 'Industry reports'}
</p>
<div class="mt-4 flex flex-wrap items-end justify-between gap-6">
  <div class="max-w-2xl">
    <h1 class="font-display text-[clamp(28px,3.2vw,38px)] leading-tight">{isJa ? '業界レポート' : 'Industry reports'}</h1>
    <p class="mt-3 leading-relaxed text-neutral-600 dark:text-neutral-300">
      {
        isJa
          ? '業界ごとの市場規模、バリューチェーン、主な企業を、出典つきの数字で整理したレポートと、その土台になる統計・バリューチェーンのページです。'
          : 'Reports on each industry’s market size, value chain and main companies, with sourced figures, plus the statistics and value-chain pages behind them. The reports are in Japanese.'
      }
    </p>
  </div>
  <dl class="flex gap-8">
    <div class="border-t-2 border-neutral-900 pt-2 dark:border-neutral-300">
      <dt class="text-xs text-neutral-500 dark:text-neutral-400">{isJa ? '業界レポート' : 'Reports'}</dt>
      <dd class="num mt-1 text-xl font-semibold">{reports.length}<span class="text-[13px] font-medium text-neutral-500 dark:text-neutral-400">{isJa ? ' 本' : ''}</span></dd>
    </div>
    <div class="border-t-2 border-neutral-900 pt-2 dark:border-neutral-300">
      <dt class="text-xs text-neutral-500 dark:text-neutral-400">{isJa ? 'トピック' : 'Topics'}</dt>
      <dd class="num mt-1 text-xl font-semibold">{topicCount}<span class="text-[13px] font-medium text-neutral-500 dark:text-neutral-400">{isJa ? ` 件・${sectors.length}分野` : ` in ${sectors.length} areas`}</span></dd>
    </div>
  </dl>
</div>

<!-- Industry reports by group -->
<section class="mt-10">
  <div class="jc-head">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h2 class="font-display text-[22px]">{isJa ? '業界レポート' : 'Industry reports'}</h2>
      <span class="text-[13px] text-neutral-500 dark:text-neutral-400">{isJa ? `${reports.length}本 · 分類ごと・番号順` : `${reports.length} reports · by group, in number order`}</span>
    </div>
    <nav class="flex flex-wrap gap-2 text-[13px]" aria-label={isJa ? '分類' : 'Groups'}>
      {groups.map((g) => <a href={`#g-${g.key}`} class="border border-neutral-300 px-3 py-1.5 font-medium hover:border-navy dark:border-neutral-700 dark:hover:border-sky">{g.name}<span class="num ml-1.5 text-neutral-500 dark:text-neutral-400">{g.rows.length}</span></a>)}
    </nav>
  </div>
  {
    groups.map((g) => (
      <div id={`g-${g.key}`} class="mb-10 scroll-mt-28">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-neutral-300 pb-2 dark:border-neutral-700">
          <h3 class="text-lg font-semibold">
            {g.name} <span class="ml-2 text-[13px] font-normal text-neutral-500 dark:text-neutral-400">{g.desc}</span>
          </h3>
          <span class="num text-[13px] text-neutral-500 dark:text-neutral-400">{g.rows.length}{isJa ? '本' : ''}</span>
        </div>
        <ul class="mt-2 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
          {g.rows.map((r) => (
            <li>
              <a href={`/ja/fieldnotes/${slugOf(r.id)}/`} class="flex items-baseline gap-3 border-b border-neutral-100 py-2.5 hover:bg-neutral-50 dark:border-neutral-900 dark:hover:bg-neutral-900">
                <span class="num w-10 shrink-0 text-xs text-neutral-500 dark:text-neutral-400">No.{r.data.no}</span>
                <span class="text-[15px] font-medium">{isJa ? r.data.title : (r.data.titleEn ?? r.data.title)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<!-- Topic index -->
<section class="mt-6">
  <div class="jc-head">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h2 class="font-display text-[22px]">{isJa ? 'トピック別の索引' : 'Topic index'}</h2>
      <span class="text-[13px] text-neutral-500 dark:text-neutral-400">{isJa ? '分野を開くと、トピックごとの統計・バリューチェーンのページに進めます' : 'Open an area to reach each topic’s statistics and value-chain pages'}</span>
    </div>
    <a href={library} class="text-[13px] font-semibold text-navy hover:underline dark:text-sky">{isJa ? 'FIELDNOTES ライブラリを開く →' : 'Open the FIELDNOTES library →'}</a>
  </div>
  <p class="mb-4 text-xs text-neutral-500 dark:text-neutral-400">
    {isJa ? '凡例：統計＝統計・業界レポート、VC＝バリューチェーン（企業への影響）。「掲載」はページあり、「共用・代表見本」は共用ページを参照、「―」は未作成です。' : 'Key: Stats = statistics and industry report, VC = value chain. Linked labels open the page; "―" means not yet written.'}
  </p>
  <div class="border-t border-neutral-200 dark:border-neutral-800">
    {
      sectors.map((s) => (
        <details class="group border-b border-neutral-200 dark:border-neutral-800">
          <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 py-4 hover:bg-neutral-50 dark:hover:bg-neutral-900">
            <span class="font-semibold">
              <span class="num mr-2 text-neutral-500 dark:text-neutral-400">{s.no}</span>{s.name}
              <span class="num ml-2 text-[13px] font-normal text-neutral-500 dark:text-neutral-400">{s.rows.filter((r) => r.kind === 'topic').length}{isJa ? '件' : ''}</span>
            </span>
            <span aria-hidden="true" class="text-neutral-500 group-open:rotate-45">＋</span>
          </summary>
          <ul class="pb-4">
            {s.rows.map((r) =>
              r.kind === 'sub' ? (
                <li class="pt-3 pb-1 text-xs font-semibold text-neutral-500 dark:text-neutral-400">{r.name}</li>
              ) : (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-neutral-100 py-2 last:border-0 dark:border-neutral-900">
                  <span class="text-[14.5px]">{r.name}</span>
                  <span class="flex gap-2 text-xs">
                    {r.states.slice(0, 2).map((st, i) =>
                      st.goto ? (
                        <a href={`${library}#/${st.goto}`} class="border border-neutral-300 px-2 py-0.5 font-medium text-navy hover:border-navy dark:border-neutral-700 dark:text-sky">
                          {kinds[i]} {st.label === '掲載' ? '' : st.label}
                        </a>
                      ) : (
                        <span class="px-2 py-0.5 text-neutral-400 dark:text-neutral-600">{kinds[i]} {st.label}</span>
                      ),
                    )}
                  </span>
                </li>
              ),
            )}
          </ul>
        </details>
      ))
    }
  </div>
</section>

<section aria-label={isJa ? '購読' : 'Subscribe'} class="mt-14 flex flex-wrap items-center justify-between gap-6 bg-neutral-50 px-6 py-8 dark:bg-neutral-900">
  <div>
    <p class="text-lg font-semibold">{isJa ? '更新をメールで受け取る' : 'Get updates by email'}</p>
    <p class="mt-1.5 text-sm text-neutral-600 dark:text-neutral-300">{isJa ? 'アナリストレポートと業界レポートの新着を、Substackでお届けします。無料です。' : 'New analyst and industry reports via Substack, free.'}</p>
  </div>
  <a href={SUBSTACK_URL} class="bg-navy px-5 py-3 text-sm font-semibold text-white hover:bg-neutral-900 dark:bg-sky dark:text-neutral-950">{isJa ? '無料で購読する' : 'Subscribe free'}</a>
</section>
