---
import '../styles/global.css';
import { NAME, CHANNELS, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL of the same page in the other language. */
  altHref: string;
  /** Kept for compatibility; every page now uses the one standard container. */
  wide?: boolean;
  /** Full-bleed page: the page draws its own sections and containers. */
  bleed?: boolean;
}

const { lang, title, description, altHref, bleed = false } = Astro.props;
const isJa = lang === 'ja';
const base = isJa ? '/ja' : '/en';
const path = Astro.url.pathname;

const SUBSTACK_URL = 'https://morokenjp.substack.com/';

// Main menu: the four research areas. Company pages sit under the
// analyst reports, so they light up that item.
const nav = [
  { href: `${base}/`, label: isJa ? 'ホーム' : 'Home', match: (p: string) => p === `${base}/` },
  { href: `${base}/news/`, label: isJa ? 'マーケット' : 'Markets', match: (p: string) => p.startsWith(`${base}/news/`) },
  {
    href: `${base}/reports/`,
    label: isJa ? 'アナリストレポート' : 'Analyst reports',
    match: (p: string) => p.startsWith(`${base}/reports/`) || p.startsWith(`${base}/companies/`),
  },
  { href: `${base}/fieldnotes/`, label: isJa ? '業界レポート' : 'Industry reports', match: (p: string) => p.startsWith(`${base}/fieldnotes/`) },
];

const footerResearch = [
  { href: `${base}/news/`, label: isJa ? 'マーケット' : 'Markets' },
  { href: `${base}/reports/`, label: isJa ? 'アナリストレポート' : 'Analyst reports' },
  { href: `${base}/fieldnotes/`, label: isJa ? '業界レポート' : 'Industry reports' },
  { href: `${base}/portfolio/`, label: isJa ? 'ポートフォリオ' : 'Portfolio' },
];
const footerAbout = [
  { href: `${base}/about/`, label: 'About' },
  { href: `${base}/works/`, label: isJa ? '実績' : 'Works' },
  { href: `${base}/contact/`, label: isJa ? 'お問い合わせ' : 'Contact' },
  { href: `${base}/policy/`, label: isJa ? '免責事項' : 'Disclaimer' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      // Apply the saved (or system) colour scheme before first paint.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (
            t === 'dark' ||
            (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-white focus:px-3 focus:py-2 focus:text-sm dark:focus:bg-neutral-900"
    >
      {isJa ? '本文へ移動' : 'Skip to content'}
    </a>

    <header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/95 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/95">
      <div class="jc-wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4">
        <a href={`${base}/`} class="flex shrink-0 items-center" aria-label={`${NAME} — ${isJa ? 'ホーム' : 'Home'}`}>
          <img src="/brand/jcore/lockup-light.svg" alt="J-Core Fundamental Research" width="186" height="36" class="block h-9 w-auto dark:hidden" />
          <img src="/brand/jcore/lockup-dark.svg" alt="" aria-hidden="true" width="186" height="36" class="hidden h-9 w-auto dark:block" />
        </a>

        <nav
          aria-label={isJa ? 'メインメニュー' : 'Main menu'}
          class="order-3 -mx-1 flex w-full gap-x-4 overflow-x-auto px-1 text-[13px] font-medium whitespace-nowrap sm:gap-x-6 sm:text-sm lg:order-none lg:w-auto lg:gap-x-7"
        >
          {
            nav.map((item) => {
              const on = item.match(path);
              return (
                <a
                  href={item.href}
                  aria-current={on ? 'page' : undefined}
                  class={
                    on
                      ? 'border-b-2 border-navy pb-1 text-neutral-900 dark:border-sky dark:text-neutral-50'
                      : 'border-b-2 border-transparent pb-1 text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-50'
                  }
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <div class="flex items-center gap-3 text-[13px]">
          <span class="text-neutral-500 dark:text-neutral-400">
            <a href={isJa ? path : altHref} class={isJa ? 'font-semibold text-neutral-900 dark:text-neutral-50' : 'hover:text-neutral-900 dark:hover:text-neutral-50'} lang="ja">JA</a>
            {' / '}
            <a href={isJa ? altHref : path} class={!isJa ? 'font-semibold text-neutral-900 dark:text-neutral-50' : 'hover:text-neutral-900 dark:hover:text-neutral-50'} lang="en">EN</a>
          </span>
          <button
            id="theme-toggle"
            type="button"
            class="inline-flex h-10 w-10 items-center justify-center border border-neutral-300 text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-900"
            aria-label={isJa ? 'ダークモード切り替え' : 'Toggle dark mode'}
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a
            href={SUBSTACK_URL}
            class="hidden border border-navy px-4 py-2.5 font-semibold text-navy hover:bg-navy hover:text-white sm:inline-block dark:border-sky dark:text-sky dark:hover:bg-sky dark:hover:text-neutral-950"
          >
            {isJa ? '無料で購読' : 'Subscribe free'}
          </a>
        </div>
      </div>
    </header>

    <main id="main" class={bleed ? '' : 'jc-wrap py-10 sm:py-12'}>
      <slot />
    </main>

    <footer class="bg-night text-neutral-300">
      <div class="jc-wrap py-12">
        <div class="grid gap-10 md:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))]">
          <div>
            <img src="/brand/jcore/lockup-dark.svg" alt="J-Core Fundamental Research" width="186" height="36" class="block h-9 w-auto" />
            <p class="mt-4 max-w-xs text-[13px] leading-relaxed text-neutral-400">
              {
                isJa
                  ? '東京を拠点に、日本の産業・素材・エネルギーを一次データで追う独立系リサーチ。'
                  : 'Independent research from Tokyo on Japanese industrials, materials and energy, built on primary data.'
              }
            </p>
          </div>
          <div class="flex flex-col gap-2.5 text-sm">
            <span class="text-[11px] font-semibold tracking-[0.12em] text-neutral-400">{isJa ? 'リサーチ' : 'RESEARCH'}</span>
            {footerResearch.map((l) => <a href={l.href} class="text-neutral-100 hover:underline">{l.label}</a>)}
          </div>
          <div class="flex flex-col gap-2.5 text-sm">
            <span class="text-[11px] font-semibold tracking-[0.12em] text-neutral-400">{isJa ? 'SNS・配信' : 'CHANNELS'}</span>
            {CHANNELS.map((c) => <a href={c.url} class="text-neutral-100 hover:underline">{c.name}</a>)}
          </div>
          <div class="flex flex-col gap-2.5 text-sm">
            <span class="text-[11px] font-semibold tracking-[0.12em] text-neutral-400">{isJa ? 'サイトについて' : 'ABOUT'}</span>
            {footerAbout.map((l) => <a href={l.href} class="text-neutral-100 hover:underline">{l.label}</a>)}
          </div>
        </div>
        <div class="mt-10 flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-neutral-800 pt-5 text-xs leading-relaxed text-neutral-400">
          <p class="max-w-3xl">
            {
              isJa
                ? '本サイトの内容は情報提供を目的としたもので、特定の有価証券の売買を勧めるものではありません。投資の判断はご自身でお願いします。'
                : 'This site is for information only and is not a recommendation to buy or sell any security. Investment decisions are your own.'
            }{' '}
            <a href={`${base}/policy/`} class="text-neutral-200 underline underline-offset-4">
              {isJa ? '免責事項' : 'Disclaimer'}
            </a>
          </p>
          <p>© {year} {NAME}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document
        .getElementById('theme-toggle')
        ?.addEventListener('click', function () {
          var dark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch (e) {}
        });
    </script>
  </body>
</html>
